{
  "name": "depcurfew",
  "version": "1.6.0",
  "description": "One supply-chain security policy for npm, pnpm, Yarn, Bun, Deno, uv, pip, Poetry, PDM, Pipenv, Composer, Bundler, Renovate and Dependabot, plus a doctor that finds config that silently does nothing.",
  "license": "MIT",
  "author": "depcurfew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/depcurfew.git"
  },
  "homepage": "https://depcurfew.github.io/",
  "bugs": {
    "url": "https://github.com/DevXord/depcurfew/issues"
  },
  "type": "module",
  "bin": {
    "depcurfew": "dist/cli.js",
    "dcf": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsdown",
    "build:action": "tsdown -c tsdown.action.config.ts",
    "test": "tsdown && vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "tsdown && publint && attw --pack . --profile esm-only",
    "docs:knowledge": "node scripts/generate-knowledge.ts",
    "docs:readme": "node scripts/generate-readme.ts",
    "data:popular": "node scripts/generate-popular.ts",
    "record:registry": "node scripts/record-registry.ts",
    "schema": "node scripts/generate-schema.ts",
    "site": "node scripts/site.ts"
  },
  "keywords": [
    "supply-chain",
    "supply-chain-security",
    "security",
    "dependency-security",
    "malicious-packages",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "deno",
    "python",
    "uv",
    "pip",
    "poetry",
    "pdm",
    "pipenv",
    "composer",
    "php",
    "bundler",
    "ruby",
    "renovate",
    "dependabot",
    "minimum-release-age",
    "cooldown",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "github-action",
    "sarif"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.6",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
