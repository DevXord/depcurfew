# Supply-chain hygiene for this repository's own dependencies.
# Pin exact versions in package.json.
save-exact=true
# Never run dependency lifecycle scripts; `npm test` / `npm run` still run (pre/post hooks do not).
ignore-scripts=true
# Release-age delay and dependency sources come from depgate.json (`depgate apply`).

# >>> depgate managed block: edit depgate.json and run depgate apply instead
min-release-age=7
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
# <<< depgate managed block
