# Supply-chain hygiene for this repository's own dependencies.
# Pin exact versions in package.json.
save-exact=true
# Never run dependency lifecycle scripts; `npm test` / `npm run` still run (pre/post hooks do not).
ignore-scripts=true
# Release-age delay and dependency sources come from depcurfew.json (`depcurfew apply`).

# >>> depcurfew managed block: edit depcurfew.json and run depcurfew apply instead
min-release-age=7
strict-allow-scripts=true
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
# <<< depcurfew managed block
