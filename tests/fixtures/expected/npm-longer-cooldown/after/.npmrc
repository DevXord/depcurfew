package-lock=true
# wait two weeks before installing a new version
# depcurfew: superseded by the managed block: min-release-age=14

# >>> depcurfew managed block: edit depcurfew.json and run depcurfew apply instead
min-release-age=3
min-release-age-exclude[]=@acme/*
min-release-age-exclude[]=left-pad
strict-allow-scripts=true
allow-git=none
allow-remote=none
allow-file=all
allow-directory=all
# <<< depcurfew managed block
