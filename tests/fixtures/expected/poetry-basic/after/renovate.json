{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "description": "depcurfew: Python packages excluded from minimumReleaseAge",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "acme-*",
        "Internal.Lib"
      ],
      "minimumReleaseAge": null
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  }
}
