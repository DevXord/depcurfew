# Project npm settings
registry=https://registry.npmjs.org/
# depgate: superseded by the managed block: min-release-age=1

# >>> depgate managed block: edit depgate.json and run depgate apply instead
min-release-age=3
min-release-age-exclude[]=@acme/*
min-release-age-exclude[]=left-pad
allow-git=none
allow-remote=none
allow-file=all
allow-directory=all
# <<< depgate managed block
save-exact=true
