# Project npm settings
registry=https://registry.npmjs.org/
# depcurfew: superseded by the managed block: min-release-age=1

# >>> depcurfew managed block: edit depcurfew.json and run depcurfew apply instead
min-release-age=3
min-release-age-exclude[]=@acme/*
min-release-age-exclude[]=left-pad
allow-git=none
allow-remote=none
allow-file=all
allow-directory=all
# <<< depcurfew managed block
save-exact=true
