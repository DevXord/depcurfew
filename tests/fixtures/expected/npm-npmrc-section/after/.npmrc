save-exact=true
# depcurfew: superseded by the managed block: min-release-age=1 # one day

# >>> depcurfew managed block: edit depcurfew.json and run depcurfew apply instead
min-release-age=3
min-release-age-exclude[]=@acme/*
min-release-age-exclude[]=left-pad
allow-git=none
allow-remote=none
allow-file=all
allow-directory=all
# <<< depcurfew managed block
# Settings read by our own scripts, not by npm
[custom]
mirror=https://example.test/
min-release-age=0
