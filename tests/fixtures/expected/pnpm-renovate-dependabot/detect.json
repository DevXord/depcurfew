{
  "packageManagers": [
    {
      "id": "pnpm",
      "supported": true,
      "evidence": [
        {
          "kind": "lockfile",
          "file": "pnpm-lock.yaml"
        },
        {
          "kind": "packageManager",
          "file": "package.json"
        },
        {
          "kind": "config",
          "file": "pnpm-workspace.yaml"
        }
      ],
      "versions": [
        {
          "version": "12.16.1",
          "source": "packageManager",
          "file": "package.json"
        }
      ],
      "configFiles": [
        "pnpm-workspace.yaml"
      ]
    }
  ],
  "node": {
    "versions": []
  },
  "bots": [
    {
      "id": "renovate",
      "configFiles": [
        "renovate.jsonc"
      ]
    },
    {
      "id": "dependabot",
      "configFiles": [
        ".github/dependabot.yml"
      ]
    }
  ],
  "workspaces": {
    "declarations": [
      {
        "file": "pnpm-workspace.yaml",
        "patterns": [
          "packages/*"
        ]
      }
    ],
    "packages": [
      "packages/a"
    ]
  },
  "npmrcFiles": [],
  "workflows": [],
  "jobs": [],
  "dockerfiles": [],
  "warnings": []
}
