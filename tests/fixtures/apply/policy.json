{
  "version": 1,
  "cooldown": {
    "minimum": "3d",
    "exclude": [
      "@acme/*",
      "left-pad"
    ],
    "securityUpdates": "bypass"
  },
  "installScripts": {
    "default": "deny",
    "allow": [
      "esbuild",
      "@scope/*"
    ]
  },
  "sources": {
    "git": "deny",
    "remoteTarball": "deny",
    "file": "allow",
    "directory": "allow"
  },
  "targets": "auto"
}
