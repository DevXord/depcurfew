{
  "version": 1,
  "cooldown": {
    "minimum": { "text": "3d", "minutes": 4320 },
    "exclude": ["@acme/*", "pypi:acme-*", "pypi:Zope.Interface", "string_decoder"],
    "securityUpdates": "bypass"
  },
  "installScripts": { "default": "deny", "allow": ["esbuild", "pypi:docopt", "pypi:typing_extensions"] },
  "targets": ["npm", "uv", "pip", "poetry"]
}
